-- monto_minor holds the amount in minor units, the same Long domain as Money.minorUnits; the decimal
-- point comes from Moneda.scale, never from the column. Exact integers keep SUM() aggregation in
-- SQLite instead of in Kotlin, which a TEXT or REAL column could not do without losing exactness.
CREATE TABLE movimiento (
    id TEXT NOT NULL PRIMARY KEY,
    tipo TEXT NOT NULL,
    monto_minor INTEGER NOT NULL,
    monto_moneda TEXT NOT NULL,
    fecha TEXT NOT NULL,
    descripcion TEXT,
    created_at TEXT NOT NULL DEFAULT '1970-01-01T00:00:00Z',
    titulo TEXT,
    categoria_id TEXT NOT NULL
);

-- The stable recent order matches this index so SQLite can scan it without a temporary sort; date-range
-- aggregate queries still benefit from fecha as the leading key.
CREATE INDEX movimiento_recent ON movimiento(fecha DESC, created_at DESC, id DESC);

-- Not movimiento_categoria: indexes share the table namespace, and schema 5 had a table with that name.
CREATE INDEX movimiento_by_categoria ON movimiento(categoria_id);

-- The repository owns integrity because SQLite foreign keys are not enabled: both tables are always
-- written in one transaction. posicion only keeps the user's display order.
CREATE TABLE movimiento_etiqueta (
    movimiento_id TEXT NOT NULL,
    etiqueta_id TEXT NOT NULL,
    posicion INTEGER NOT NULL,
    PRIMARY KEY (movimiento_id, etiqueta_id)
);

CREATE INDEX movimiento_etiqueta_etiqueta ON movimiento_etiqueta(etiqueta_id);

-- Every read goes through this view so a row and its etiquetas come from one statement, hence one
-- snapshot, and observers invalidate on both tables. group_concat order is unspecified on SQLite 3.32,
-- so each id carries its posicion (unit separator) and the mapper sorts; groups use the record separator.
CREATE VIEW movimiento_con_etiquetas AS
SELECT
    movimiento.*,
    COALESCE(
        (
            SELECT group_concat(movimiento_etiqueta.posicion || char(31) || movimiento_etiqueta.etiqueta_id, char(30))
            FROM movimiento_etiqueta
            WHERE movimiento_etiqueta.movimiento_id = movimiento.id
        ),
        ''
    ) AS etiqueta_ids
FROM movimiento;

insertMovimiento:
INSERT INTO movimiento(id, tipo, monto_minor, monto_moneda, fecha, titulo, descripcion, created_at, categoria_id)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

insertMovimientoEtiqueta:
INSERT INTO movimiento_etiqueta(movimiento_id, etiqueta_id, posicion)
VALUES (?, ?, ?);

selectAllMovimientos:
SELECT *
FROM movimiento_con_etiquetas
ORDER BY fecha DESC, created_at DESC, id DESC;

-- SQLite date functions have a narrower year domain than the canonical LocalDate text we persist.
selectMovimientoYears:
SELECT DISTINCT substr(fecha, 1, length(fecha) - 6) AS movimiento_year
FROM movimiento
WHERE monto_moneda = ?
ORDER BY CAST(movimiento_year AS INTEGER) DESC;

selectRecentMovimientos:
SELECT *
FROM movimiento_con_etiquetas
ORDER BY fecha DESC, created_at DESC, id DESC
LIMIT ?;

selectRecentMovimientosByMoneda:
SELECT *
FROM movimiento_con_etiquetas
WHERE monto_moneda = ?
ORDER BY fecha DESC, created_at DESC, id DESC
LIMIT ?;

selectCategoryHistory:
SELECT titulo, categoria_id, created_at
FROM movimiento
WHERE titulo IS NOT NULL AND trim(titulo) <> ''
ORDER BY created_at DESC, id DESC
LIMIT ?;

selectMovimientoById:
SELECT *
FROM movimiento_con_etiquetas
WHERE id = ?;

selectMovimientosInRange:
SELECT *
FROM movimiento_con_etiquetas
WHERE monto_moneda = ? AND fecha >= ? AND fecha <= ?
ORDER BY fecha DESC, created_at DESC, id DESC;

-- Filtering lives in SQL so rows, years and listeners share one snapshot; the repository picks one
-- query per combination of the optional category and etiqueta sets.
selectFilteredMovimientos:
SELECT *
FROM movimiento_con_etiquetas
WHERE monto_moneda = :moneda
  AND (:start_date IS NULL OR fecha >= :start_date)
  AND (:end_date IS NULL OR fecha <= :end_date)
  AND (:movement_type IS NULL OR tipo = :movement_type)
ORDER BY fecha DESC, created_at DESC, id DESC;

-- A selected parent also matches its children; the roll-up never goes upward, so a selected child
-- matches only itself. The unary + keeps SQLite scanning movimiento_recent: picking
-- movimiento_by_categoria instead would sort every match in a temporary B-tree.
selectFilteredMovimientosByCategory:
SELECT *
FROM movimiento_con_etiquetas
WHERE monto_moneda = :moneda
  AND (:start_date IS NULL OR fecha >= :start_date)
  AND (:end_date IS NULL OR fecha <= :end_date)
  AND (:movement_type IS NULL OR tipo = :movement_type)
  AND (
      +categoria_id IN :category_ids
      OR +categoria_id IN (SELECT id FROM categoria WHERE padre_id IN :category_ids)
  )
ORDER BY fecha DESC, created_at DESC, id DESC;

-- A movimiento matches through any of its etiquetas.
selectFilteredMovimientosByEtiqueta:
SELECT *
FROM movimiento_con_etiquetas
WHERE monto_moneda = :moneda
  AND (:start_date IS NULL OR fecha >= :start_date)
  AND (:end_date IS NULL OR fecha <= :end_date)
  AND (:movement_type IS NULL OR tipo = :movement_type)
  AND EXISTS (
      SELECT 1
      FROM movimiento_etiqueta
      WHERE movimiento_etiqueta.movimiento_id = movimiento_con_etiquetas.id
        AND movimiento_etiqueta.etiqueta_id IN :etiqueta_ids
  )
ORDER BY fecha DESC, created_at DESC, id DESC;

selectFilteredMovimientosByCategoryAndEtiqueta:
SELECT *
FROM movimiento_con_etiquetas
WHERE monto_moneda = :moneda
  AND (:start_date IS NULL OR fecha >= :start_date)
  AND (:end_date IS NULL OR fecha <= :end_date)
  AND (:movement_type IS NULL OR tipo = :movement_type)
  AND (
      +categoria_id IN :category_ids
      OR +categoria_id IN (SELECT id FROM categoria WHERE padre_id IN :category_ids)
  )
  AND EXISTS (
      SELECT 1
      FROM movimiento_etiqueta
      WHERE movimiento_etiqueta.movimiento_id = movimiento_con_etiquetas.id
        AND movimiento_etiqueta.etiqueta_id IN :etiqueta_ids
  )
ORDER BY fecha DESC, created_at DESC, id DESC;

updateMovimiento:
UPDATE movimiento
SET tipo = ?, monto_minor = ?, fecha = ?, titulo = ?, descripcion = ?, categoria_id = ?
WHERE id = ?;

deleteMovimientoEtiquetas:
DELETE FROM movimiento_etiqueta
WHERE movimiento_id = ?;

deleteMovimiento:
DELETE FROM movimiento
WHERE id = ?;

sumMovimientosByTipo:
SELECT tipo, SUM(monto_minor) AS total_minor
FROM movimiento
WHERE monto_moneda = ?
GROUP BY tipo;

-- Grouped by tipo as well as categoria_id so gastos and ingresos in the same categoria never net
-- each other out. Filtered by moneda because minor units of different currencies are different units
-- and adding them is meaningless.
sumMovimientosPorCategoria:
SELECT categoria_id, tipo, SUM(monto_minor) AS total_minor
FROM movimiento
WHERE monto_moneda = ? AND fecha BETWEEN ? AND ?
GROUP BY categoria_id, tipo;
