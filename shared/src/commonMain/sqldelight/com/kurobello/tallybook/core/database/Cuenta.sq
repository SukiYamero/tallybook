-- moneda lives only here: a movimiento or transferencia gets its currency through its cuenta, so the
-- two can never disagree. saldo_inicial_minor is signed, in that currency's minor units (a credit
-- card's opening debt is negative). No index besides the primary key: an installation holds a
-- handful of accounts, and every join reaches them by id.
-- updated_at has no DEFAULT so a write that forgets its ChangeStamp fails instead of becoming SEED.
CREATE TABLE cuenta (
    id TEXT NOT NULL PRIMARY KEY,
    nombre TEXT NOT NULL,
    tipo TEXT NOT NULL CHECK (tipo IN ('EFECTIVO', 'BANCO', 'CREDITO')),
    moneda TEXT NOT NULL,
    saldo_inicial_minor INTEGER NOT NULL DEFAULT 0,
    dia_corte INTEGER CHECK (dia_corte BETWEEN 1 AND 31),
    archivada INTEGER NOT NULL DEFAULT 0 CHECK (archivada IN (0, 1)),
    created_at TEXT NOT NULL,
    updated_at TEXT NOT NULL,
    deleted_at TEXT
);

insertCuenta:
INSERT INTO cuenta(id, nombre, tipo, moneda, saldo_inicial_minor, dia_corte, archivada, created_at, updated_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

selectCuentaById:
SELECT *
FROM cuenta
WHERE id = ? AND deleted_at IS NULL;

-- Tombstones included: an insert must never reuse an id a tombstone still holds.
countCuentasWithId:
SELECT COUNT(*)
FROM cuenta
WHERE id = ?;

countLiveCuentas:
SELECT COUNT(*)
FROM cuenta
WHERE deleted_at IS NULL;

selectAllCuentas:
SELECT *
FROM cuenta
WHERE deleted_at IS NULL
ORDER BY created_at, id;

updateCuenta:
UPDATE cuenta
SET nombre = :nombre, tipo = :tipo, moneda = :moneda, saldo_inicial_minor = :saldo_inicial_minor, dia_corte = :dia_corte, updated_at = :updated_at
WHERE id = :id AND deleted_at IS NULL;

updateCuentaArchivada:
UPDATE cuenta
SET archivada = :archivada, updated_at = :updated_at
WHERE id = :id AND deleted_at IS NULL;

tombstoneCuenta:
UPDATE cuenta
SET updated_at = :stamp, deleted_at = :stamp
WHERE id = :id AND deleted_at IS NULL;

countActiveCuentasExcept:
SELECT COUNT(*)
FROM cuenta
WHERE deleted_at IS NULL AND archivada = 0 AND id <> ?;

-- Summed per column rather than OR-ed so each count searches its own partial index; a transfer never
-- has the same cuenta on both sides, so no row is counted twice.
countCuentaReferences:
SELECT
    (SELECT COUNT(*) FROM movimiento WHERE cuenta_id = :id AND deleted_at IS NULL)
    + (SELECT COUNT(*) FROM transferencia WHERE cuenta_origen_id = :id AND deleted_at IS NULL)
    + (SELECT COUNT(*) FROM transferencia WHERE cuenta_destino_id = :id AND deleted_at IS NULL)
    AS reference_count;

-- The one definition of a referenced cuenta, read by both the type and currency locks and the
-- screens that disable those fields. Each arm walks its own partial index in order, so the UNION
-- merges without a sort.
selectReferencedCuentaIds:
SELECT cuenta_id FROM movimiento WHERE deleted_at IS NULL
UNION
SELECT cuenta_origen_id FROM transferencia WHERE deleted_at IS NULL
UNION
SELECT cuenta_destino_id FROM transferencia WHERE deleted_at IS NULL;
