-- Recurring movimientos: recurrencia and its etiquetas are new, and movimiento gains recurrencia_id.
-- movimiento is rebuilt so the migrated DDL matches a fresh install exactly, where the column sits
-- before the stamps; the view goes first because renaming a table rewrites the views that reference
-- it, and the indexes go with it so their names are free again. Stamps are copied unchanged: no
-- existing movimiento came from a recurrencia.
DROP VIEW movimiento_con_etiquetas;

DROP INDEX movimiento_recent;

DROP INDEX movimiento_by_categoria;

DROP INDEX movimiento_by_cuenta;

ALTER TABLE movimiento RENAME TO movimiento_legacy;

CREATE TABLE movimiento (
    id TEXT NOT NULL PRIMARY KEY,
    tipo TEXT NOT NULL,
    monto_minor INTEGER NOT NULL,
    fecha TEXT NOT NULL,
    descripcion TEXT,
    created_at TEXT NOT NULL DEFAULT '1970-01-01T00:00:00Z',
    titulo TEXT,
    categoria_id TEXT NOT NULL,
    cuenta_id TEXT NOT NULL,
    medio_pago TEXT NOT NULL CHECK (medio_pago IN ('EFECTIVO', 'DEBITO', 'TRANSFERENCIA', 'CREDITO')),
    recurrencia_id TEXT,
    updated_at TEXT NOT NULL,
    deleted_at TEXT
);

INSERT INTO movimiento(id, tipo, monto_minor, fecha, descripcion, created_at, titulo, categoria_id, cuenta_id, medio_pago, updated_at, deleted_at)
SELECT id, tipo, monto_minor, fecha, descripcion, created_at, titulo, categoria_id, cuenta_id, medio_pago, updated_at, deleted_at
FROM movimiento_legacy;

DROP TABLE movimiento_legacy;

CREATE INDEX movimiento_recent ON movimiento(fecha DESC, created_at DESC, id DESC)
WHERE deleted_at IS NULL;

CREATE INDEX movimiento_by_categoria ON movimiento(categoria_id)
WHERE deleted_at IS NULL;

CREATE INDEX movimiento_by_cuenta ON movimiento(cuenta_id)
WHERE deleted_at IS NULL;

CREATE VIEW movimiento_con_etiquetas AS
SELECT
    movimiento.*,
    cuenta.moneda AS monto_moneda,
    COALESCE(
        (
            SELECT group_concat(movimiento_etiqueta.posicion || char(31) || movimiento_etiqueta.etiqueta_id, char(30))
            FROM movimiento_etiqueta
            WHERE movimiento_etiqueta.movimiento_id = movimiento.id
        ),
        ''
    ) AS etiqueta_ids
FROM movimiento
JOIN cuenta ON cuenta.id = movimiento.cuenta_id
WHERE movimiento.deleted_at IS NULL;

CREATE TABLE recurrencia (
    id TEXT NOT NULL PRIMARY KEY,
    tipo TEXT NOT NULL CHECK (tipo IN ('GASTO', 'INGRESO')),
    monto_minor INTEGER NOT NULL CHECK (monto_minor > 0),
    titulo TEXT,
    descripcion TEXT,
    categoria_id TEXT NOT NULL,
    cuenta_id TEXT NOT NULL,
    medio_pago TEXT NOT NULL CHECK (medio_pago IN ('EFECTIVO', 'DEBITO', 'TRANSFERENCIA', 'CREDITO')),
    frecuencia TEXT NOT NULL CHECK (frecuencia IN ('SEMANAL', 'MENSUAL', 'ANUAL')),
    fecha_ancla TEXT NOT NULL,
    proxima_fecha TEXT NOT NULL,
    created_at TEXT NOT NULL,
    updated_at TEXT NOT NULL,
    deleted_at TEXT
);

CREATE TABLE recurrencia_etiqueta (
    recurrencia_id TEXT NOT NULL,
    etiqueta_id TEXT NOT NULL,
    posicion INTEGER NOT NULL,
    PRIMARY KEY (recurrencia_id, etiqueta_id)
);

CREATE VIEW recurrencia_con_etiquetas AS
SELECT
    recurrencia.*,
    cuenta.moneda AS monto_moneda,
    COALESCE(
        (
            SELECT group_concat(recurrencia_etiqueta.posicion || char(31) || recurrencia_etiqueta.etiqueta_id, char(30))
            FROM recurrencia_etiqueta
            WHERE recurrencia_etiqueta.recurrencia_id = recurrencia.id
        ),
        ''
    ) AS etiqueta_ids
FROM recurrencia
JOIN cuenta ON cuenta.id = recurrencia.cuenta_id
WHERE recurrencia.deleted_at IS NULL;
