-- No tipo column: a categoria is gasto or ingreso only through the movimiento that references it
-- (cat_ingresos is just another parent). icono is a Lucide name, color a theme-token name, not a hex.
-- origen separates seeded rows, whose nombre follows the app language, from rows the user owns.
-- updated_at has no DEFAULT so a write that forgets its ChangeStamp fails instead of becoming SEED.
CREATE TABLE categoria (
    id TEXT NOT NULL PRIMARY KEY,
    nombre TEXT NOT NULL,
    padre_id TEXT,
    icono TEXT NOT NULL,
    color TEXT NOT NULL,
    descripcion TEXT,
    origen TEXT NOT NULL DEFAULT 'sistema' CHECK (origen IN ('sistema', 'usuario')),
    oculta INTEGER NOT NULL DEFAULT 0 CHECK (oculta IN (0, 1)),
    updated_at TEXT NOT NULL,
    deleted_at TEXT
);

insertCategoriaIfAbsent:
INSERT OR IGNORE INTO categoria(id, nombre, padre_id, icono, color, updated_at)
VALUES (?, ?, ?, ?, ?, ?);

insertCategoria:
INSERT INTO categoria(id, nombre, padre_id, icono, color, updated_at)
VALUES (?, ?, ?, ?, ?, ?);

insertCustomCategoria:
INSERT INTO categoria(id, nombre, padre_id, icono, color, descripcion, origen, oculta, updated_at)
VALUES (:id, :nombre, NULL, :icono, :color, :descripcion, 'usuario', 0, :updated_at);

selectAllCategorias:
SELECT *
FROM categoria
WHERE deleted_at IS NULL;

selectCategoriaById:
SELECT *
FROM categoria
WHERE id = ? AND deleted_at IS NULL;

updateCategoriaNombre:
UPDATE categoria
SET nombre = :nombre
WHERE id = :id;

updateCustomCategoria:
UPDATE categoria
SET nombre = :nombre, icono = :icono, color = :color, descripcion = :descripcion, updated_at = :updated_at
WHERE id = :id AND origen = 'usuario' AND deleted_at IS NULL;

updateCategoriaOculta:
UPDATE categoria
SET oculta = :oculta, updated_at = :updated_at
WHERE id = :id AND deleted_at IS NULL;

tombstoneCustomCategoria:
UPDATE categoria
SET updated_at = :stamp, deleted_at = :stamp
WHERE id = :id AND origen = 'usuario' AND deleted_at IS NULL;

-- Any currency: a custom categoria can be deleted only while no live movimiento references it.
countMovimientosForCategoria:
SELECT COUNT(*)
FROM movimiento
WHERE categoria_id = ? AND deleted_at IS NULL;

-- The set selectFilteredMovimientosByCategory returns for one categoria: its own movimientos plus
-- those of its children. A movimiento has one categoria, so it lands in at most one bucket per level.
countMovimientosPorCategoria:
SELECT bucket.categoria_id, COUNT(*) AS movimiento_count
FROM (
    SELECT movimiento.categoria_id
    FROM movimiento
    WHERE movimiento.monto_moneda = :moneda AND movimiento.deleted_at IS NULL
    UNION ALL
    SELECT categoria.padre_id AS categoria_id
    FROM movimiento
    JOIN categoria ON categoria.id = movimiento.categoria_id
    WHERE movimiento.monto_moneda = :moneda
      AND movimiento.deleted_at IS NULL
      AND categoria.padre_id IS NOT NULL
) AS bucket
GROUP BY bucket.categoria_id;
