-- No tipo column: a categoria is gasto or ingreso only through the movimiento that references it
-- (cat_ingresos is just another parent). icono is a Lucide name, color a theme-token name, not a hex.
-- origen separates seeded rows, whose nombre follows the app language, from rows the user owns.
CREATE TABLE categoria (
    id TEXT NOT NULL PRIMARY KEY,
    nombre TEXT NOT NULL,
    padre_id TEXT,
    icono TEXT NOT NULL,
    color TEXT NOT NULL,
    descripcion TEXT,
    origen TEXT NOT NULL DEFAULT 'sistema' CHECK (origen IN ('sistema', 'usuario')),
    oculta INTEGER NOT NULL DEFAULT 0 CHECK (oculta IN (0, 1))
);

insertCategoriaIfAbsent:
INSERT OR IGNORE INTO categoria(id, nombre, padre_id, icono, color)
VALUES (?, ?, ?, ?, ?);

insertCategoria:
INSERT INTO categoria(id, nombre, padre_id, icono, color)
VALUES (?, ?, ?, ?, ?);

insertCustomCategoria:
INSERT INTO categoria(id, nombre, padre_id, icono, color, descripcion, origen, oculta)
VALUES (:id, :nombre, NULL, :icono, :color, :descripcion, 'usuario', 0);

selectAllCategorias:
SELECT *
FROM categoria;

selectCategoriaById:
SELECT *
FROM categoria
WHERE id = ?;

updateCategoriaNombre:
UPDATE categoria
SET nombre = :nombre
WHERE id = :id;

updateCustomCategoria:
UPDATE categoria
SET nombre = :nombre, icono = :icono, color = :color, descripcion = :descripcion
WHERE id = :id AND origen = 'usuario';

updateCategoriaOculta:
UPDATE categoria
SET oculta = :oculta
WHERE id = :id;

deleteCustomCategoria:
DELETE FROM categoria
WHERE id = :id AND origen = 'usuario';

-- Any currency: a custom categoria can be deleted only while no movimiento references it at all.
-- The join table's primary key already makes every row a distinct movimiento.
countMovimientosForCategoria:
SELECT COUNT(*)
FROM movimiento_categoria
WHERE categoria_id = ?;

-- The set selectFilteredMovimientosByCategory returns for one categoria: its own links plus every
-- link to one of its children, so a parent counts a movimiento once even with two children on it.
countMovimientosPorCategoria:
SELECT bucket.categoria_id, COUNT(DISTINCT movimiento.id) AS movimiento_count
FROM (
    SELECT movimiento_id, categoria_id
    FROM movimiento_categoria
    UNION ALL
    SELECT movimiento_categoria.movimiento_id, categoria.padre_id AS categoria_id
    FROM movimiento_categoria
    JOIN categoria ON categoria.id = movimiento_categoria.categoria_id
    WHERE categoria.padre_id IS NOT NULL
) AS bucket
JOIN movimiento ON movimiento.id = bucket.movimiento_id
WHERE movimiento.monto_moneda = ?
GROUP BY bucket.categoria_id;
