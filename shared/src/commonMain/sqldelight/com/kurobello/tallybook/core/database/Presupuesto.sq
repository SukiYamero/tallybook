-- A monthly spending limit on one categoria in one currency, counting the gasto of its direct
-- subcategorias too. The currency is stored because a categoria has none: movimiento takes it from
-- cuenta. updated_at has no DEFAULT so a write that forgets its ChangeStamp fails instead of
-- becoming SEED.
CREATE TABLE presupuesto (
    id TEXT NOT NULL PRIMARY KEY,
    categoria_id TEXT NOT NULL,
    moneda TEXT NOT NULL,
    monto_minor INTEGER NOT NULL CHECK (monto_minor > 0),
    created_at TEXT NOT NULL,
    updated_at TEXT NOT NULL,
    deleted_at TEXT
);

CREATE INDEX presupuesto_categoria ON presupuesto(categoria_id);

insertPresupuesto:
INSERT INTO presupuesto(id, categoria_id, moneda, monto_minor, created_at, updated_at)
VALUES (?, ?, ?, ?, ?, ?);

selectLiveById:
SELECT *
FROM presupuesto
WHERE id = ? AND deleted_at IS NULL;

selectLiveByCategoriaMoneda:
SELECT *
FROM presupuesto
WHERE categoria_id = :categoria_id AND moneda = :moneda AND deleted_at IS NULL;

-- The unary + keeps movimiento_by_categoria out of the OR, which it cannot serve. The categoria is
-- joined without a deleted_at filter: a tombstoned categoria tombstones its budgets in the same
-- write, and a hidden one keeps counting.
selectLiveWithSpent:
SELECT
    p.*,
    categoria.nombre AS categoria_nombre,
    categoria.padre_id AS categoria_padre_id,
    COALESCE(
        (
            SELECT SUM(m.monto_minor)
            FROM movimiento m
            JOIN cuenta c ON c.id = m.cuenta_id
            WHERE m.deleted_at IS NULL
              AND m.tipo = 'GASTO'
              AND c.moneda = p.moneda
              AND m.fecha BETWEEN :start_date AND :end_date
              AND (
                  +m.categoria_id = p.categoria_id
                  OR +m.categoria_id IN (SELECT id FROM categoria WHERE padre_id = p.categoria_id)
              )
        ),
        0
    ) AS spent_minor
FROM presupuesto p
JOIN categoria ON categoria.id = p.categoria_id
WHERE p.deleted_at IS NULL;

updatePresupuestoMonto:
UPDATE presupuesto
SET monto_minor = :monto_minor, updated_at = :updated_at
WHERE id = :id AND deleted_at IS NULL;

tombstonePresupuesto:
UPDATE presupuesto
SET updated_at = :stamp, deleted_at = :stamp
WHERE id = :id AND deleted_at IS NULL;

tombstonePresupuestosByCategoria:
UPDATE presupuesto
SET updated_at = :stamp, deleted_at = :stamp
WHERE categoria_id = :categoria_id AND deleted_at IS NULL;

sumGastoPresupuestoPorMes:
SELECT substr(m.fecha, 1, 7) AS month, SUM(m.monto_minor) AS total_minor
FROM movimiento m
JOIN cuenta c ON c.id = m.cuenta_id
WHERE m.deleted_at IS NULL
  AND m.tipo = 'GASTO'
  AND c.moneda = :moneda
  AND m.fecha BETWEEN :start_date AND :end_date
  AND (
      +m.categoria_id = :categoria_id
      OR +m.categoria_id IN (SELECT id FROM categoria WHERE padre_id = :categoria_id)
  )
GROUP BY month;
